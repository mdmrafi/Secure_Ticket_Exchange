# ==============================================================================
# SECURE DIGITAL ASSET EXCHANGE - STAGING ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.staging on your staging server or container environment:
#   cp .env.staging.example .env.staging
#
# All placeholders enclosed in <...> MUST be populated with real staging credentials.
# NOTE: Never commit sensitive credentials or real secrets to Git!
# ==============================================================================

# Node Runtime
NODE_ENV=staging
PORT=5000
API_PREFIX=/api/v1

# Database Configuration (Staging MongoDB Replica Set with TLS)
MONGODB_URI=mongodb+srv://<STAGING_DB_USER>:<STAGING_DB_PASSWORD>@<STAGING_CLUSTER_HOST>/secure_asset_exchange_staging?retryWrites=true&w=majority&appName=SecureTicketExchangeStaging
MONGODB_MAX_POOL_SIZE=25
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Client & CORS (Staging domain)
CORS_ORIGIN=https://staging.exchange.example.com
CLIENT_URL=https://staging.exchange.example.com

# Authentication & JWT Secrets (Cryptographically secure, min 32 characters, unique to staging)
AUTH_PROVIDER=jwt
JWT_SECRET=<GENERATE_SECURE_RANDOM_STAGING_KEY_MIN_32_CHARS>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<GENERATE_SECURE_RANDOM_STAGING_REFRESH_KEY_MIN_32_CHARS>
JWT_REFRESH_EXPIRES_IN=7d
JWT_EXPIRES_IN=15m
JWT_COOKIE_EXPIRES_IN=7
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# Optional Clerk Auth
CLERK_SECRET_KEY=<STAGING_CLERK_SECRET_KEY>
CLERK_PUBLISHABLE_KEY=<STAGING_CLERK_PUBLISHABLE_KEY>

# Inngest Background Jobs (Staging Inngest Cloud or Server)
INNGEST_EVENT_KEY=<STAGING_INNGEST_EVENT_KEY>
INNGEST_SIGNING_KEY=<STAGING_INNGEST_SIGNING_KEY>
INNGEST_APP_ID=secure-asset-exchange-staging

# Payment Provider Configuration (Stripe Sandbox or Mock Gateway)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=<GENERATE_STAGING_WEBHOOK_SECRET_MIN_32_CHARS>
STRIPE_SECRET_KEY=sk_test_<STAGING_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=whsec_<STAGING_STRIPE_WEBHOOK_SECRET>
SSLCOMMERZ_STORE_ID=<STAGING_SSLCOMMERZ_ID>
SSLCOMMERZ_STORE_PASS=<STAGING_SSLCOMMERZ_PASS>
SSLCOMMERZ_IS_SANDBOX=true

# Logging & Observability
LOG_LEVEL=info

# Rate Limiting (Staging protection)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# KYC Identity Verification Module (AES-256-GCM 32-byte key)
KYC_PROVIDER=mock
KYC_ENCRYPTION_KEY=<GENERATE_32_BYTE_HEX_OR_ASCII_STAGING_KEY>
KYC_EXPIRY_DAYS=365
KYC_EXTERNAL_API_KEY=<STAGING_KYC_API_KEY>
KYC_EXTERNAL_BASE_URL=https://staging-api.external-kyc-provider.com/v1

# Monitoring & Prometheus Metrics
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=<GENERATE_SECURE_METRICS_BEARER_TOKEN>
