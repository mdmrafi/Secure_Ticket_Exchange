# ==============================================================================
# SECURE DIGITAL ASSET EXCHANGE - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.production on your secure production container/server:
#   cp .env.production.example .env.production
#
# IMPORTANT PRODUCTION SECURITY REQUIREMENTS:
# 1. All secrets MUST be unique, cryptographically random, and at least 32 characters.
# 2. NEVER commit actual production values or secrets to any Git repository.
# 3. Use an external secret manager (AWS Secrets Manager, HashiCorp Vault, Doppler).
# 4. HTTPS is MANDATORY. COOKIE_SECURE must be true.
# ==============================================================================

# Node Runtime
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# Database Configuration (Production MongoDB Atlas / Sharded Replica Set with TLS & Auth)
MONGODB_URI=mongodb+srv://<PROD_DB_USER>:<PROD_DB_PASSWORD>@<PROD_CLUSTER_HOST>/secure_asset_exchange_prod?retryWrites=true&w=majority&appName=SecureTicketExchangeProd
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Client & CORS Restrictions (Strict Production HTTPS FQDN)
CORS_ORIGIN=https://exchange.yourdomain.com
CLIENT_URL=https://exchange.yourdomain.com

# Authentication & JWT Secrets (Strictly enforced: min 32 chars, cannot contain 'change_in_production')
AUTH_PROVIDER=jwt
JWT_SECRET=<GENERATE_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_MIN_32_BYTES>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<GENERATE_CRYPTOGRAPHICALLY_SECURE_RANDOM_REFRESH_SECRET_MIN_32_BYTES>
JWT_REFRESH_EXPIRES_IN=7d
JWT_EXPIRES_IN=15m
JWT_COOKIE_EXPIRES_IN=7
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# Optional Clerk Auth (Production instance)
CLERK_SECRET_KEY=<PROD_CLERK_SECRET_KEY>
CLERK_PUBLISHABLE_KEY=<PROD_CLERK_PUBLISHABLE_KEY>

# Inngest Background Jobs (Production Inngest Cloud / Self-Hosted)
INNGEST_EVENT_KEY=<PROD_INNGEST_EVENT_KEY>
INNGEST_SIGNING_KEY=<PROD_INNGEST_SIGNING_KEY>
INNGEST_APP_ID=secure-asset-exchange-prod

# Payment Provider Configuration (Production Stripe / SSLCommerz / etc.)
PAYMENT_PROVIDER=stripe
PAYMENT_WEBHOOK_SECRET=<PROD_PAYMENT_WEBHOOK_SIGNING_SECRET_MIN_32_BYTES>
STRIPE_SECRET_KEY=sk_live_<PROD_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=whsec_<PROD_STRIPE_WEBHOOK_SECRET>
SSLCOMMERZ_STORE_ID=<PROD_SSLCOMMERZ_STORE_ID>
SSLCOMMERZ_STORE_PASS=<PROD_SSLCOMMERZ_STORE_PASS>
SSLCOMMERZ_IS_SANDBOX=false

# Logging & Observability (Structured JSON format for centralized log collectors like Datadog/ELK)
LOG_LEVEL=info

# Rate Limiting (DDoS & Brute-Force mitigation)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# KYC Identity Verification Module (AES-256-GCM 32-byte encryption key for sensitive document storage)
KYC_PROVIDER=external
KYC_ENCRYPTION_KEY=<PROD_AES_GCM_256_BIT_SECRET_EXACTLY_32_BYTES>
KYC_EXPIRY_DAYS=365
KYC_EXTERNAL_API_KEY=<PROD_EXTERNAL_KYC_API_KEY>
KYC_EXTERNAL_BASE_URL=https://api.external-kyc-provider.com/v1

# Monitoring & Prometheus Metrics
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=<GENERATE_HIGH_ENTROPY_PROMETHEUS_SCRAPE_BEARER_TOKEN>
