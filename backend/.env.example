# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ngbsvuu.mongodb.net/secure_asset_exchange?retryWrites=true&w=majority&appName=Cluster0
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Client & CORS Configuration
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Authentication Provider Configuration
# Supported providers: 'jwt' (built-in default) or 'clerk' (external adapter)
AUTH_PROVIDER=jwt

# JWT Configuration (Used when AUTH_PROVIDER=jwt)
JWT_SECRET=super_secret_jwt_encryption_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Clerk Configuration (Used when AUTH_PROVIDER=clerk)
CLERK_SECRET_KEY=sk_test_placeholder_key_for_future_clerk_integration
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# Inngest Background Jobs Configuration
INNGEST_EVENT_KEY=local_development_inngest_event_key
INNGEST_SIGNING_KEY=
INNGEST_APP_ID=secure-asset-exchange

# Logging Configuration
# Levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# KYC Identity Verification
KYC_PROVIDER=mock
KYC_ENCRYPTION_KEY=super_secret_kyc_aes_gcm_encryption_key_32_bytes_min!
KYC_EXPIRY_DAYS=365
KYC_EXTERNAL_API_KEY=
KYC_EXTERNAL_BASE_URL=https://api.external-kyc-provider.com/v1
