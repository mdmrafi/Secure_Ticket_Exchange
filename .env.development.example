# ==============================================================================
# SECURE DIGITAL ASSET EXCHANGE - DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env or .env.development:
#   cp .env.development.example .env
#
# NOTE: Never commit sensitive credentials or real production secrets to Git!
# ==============================================================================

# Node Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database Configuration (Local MongoDB or Atlas Dev Cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/secure_asset_exchange_dev
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Client & CORS
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Authentication & JWT Secrets (Development placeholder keys allowed in dev mode only)
AUTH_PROVIDER=jwt
JWT_SECRET=super_secret_jwt_encryption_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_EXPIRES_IN=15m
JWT_COOKIE_EXPIRES_IN=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Optional Clerk Auth (if AUTH_PROVIDER=clerk)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Inngest Background Jobs (Local dev mode uses inngest-cli)
INNGEST_EVENT_KEY=local_dev_key
INNGEST_SIGNING_KEY=local_dev_signing_key
INNGEST_APP_ID=secure-asset-exchange-dev

# Payment Provider Configuration (Mock for development)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=mock_payment_webhook_secret_key_32_bytes_min_exchange
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
SSLCOMMERZ_IS_SANDBOX=true

# Logging & Observability
LOG_LEVEL=debug

# Rate Limiting (Permissive for local development)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# KYC Identity Verification Module
KYC_PROVIDER=mock
KYC_ENCRYPTION_KEY=super_secret_kyc_aes_gcm_encryption_key_32_bytes_min!
KYC_EXPIRY_DAYS=365
KYC_EXTERNAL_API_KEY=
KYC_EXTERNAL_BASE_URL=https://api.external-kyc-provider.com/v1

# Monitoring & Prometheus Metrics
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=dev_metrics_token_change_in_prod
